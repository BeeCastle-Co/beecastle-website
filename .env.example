# The product and the help centre. Defaults are production; override for staging.
PUBLIC_APP_URL=https://suite.beecastle.com
PUBLIC_HELP_URL=http://help.suite.beecastle.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Unset: no tag, nothing sent.
# Only emitted on production deploys; Netlify previews never send data.
# Setting it here turns GA on locally, in debug mode (GA4 DebugView).
PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the content="..." value).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contentful (server-side only, no PUBLIC_ prefix). Not wired up yet: content
# currently lives in src/content/ as Markdown. See CLAUDE.md, "Moving to Contentful".
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
