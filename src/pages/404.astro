---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Illustration from '../components/Illustration.astro';
---
<Layout title="Page not found | BeeCastle" description="The page you were looking for has buzzed off." noindex>
  <section class="px-gut pb-sec pt-[clamp(140px,14vw,200px)] text-center">
    <div class="mx-auto max-w-[640px]">
      <Illustration name="bee-404" alt="404" class="mx-auto w-full max-w-[380px]" />
      <h1 class="m-0 mt-8 text-h2 font-extrabold">This page has buzzed off</h1>
      <p class="m-0 mt-4 text-lede text-ink-3">It may have moved when we rebuilt the site. Try the homepage or the blog.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg">Back to the hive</Button>
        <Button href="/blog/" variant="outline" size="lg">Read the blog</Button>
      </div>
    </div>
  </section>
</Layout>
