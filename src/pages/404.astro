---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Illustration from '../components/Illustration.astro';
import T from '../components/T.astro';
---
<Layout title="Page not found | BeeCastle" description="The page you were looking for has buzzed off." noindex>
  <section class="px-gut pb-sec pt-[clamp(140px,14vw,200px)] text-center">
    <div class="mx-auto max-w-[640px]">
      <Illustration name="bee-404" alt="404" class="mx-auto w-full max-w-[380px]" />
      <T as="h1" k="notFound.heading" class="m-0 mt-8 text-h2 font-extrabold" />
      <T as="p" k="notFound.body" class="m-0 mt-4 text-lede text-ink-3" />
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg" k="notFound.back" />
        <Button href="/blog/" variant="outline" size="lg" k="cta.readTheBlog" />
      </div>
    </div>
  </section>
</Layout>
