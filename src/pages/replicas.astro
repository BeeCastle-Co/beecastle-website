---
/* Every product replica on one page, for reviewing them. Not linked from the
   site and kept out of search. The replicas live in src/components/product/
   and all of their data is invented, in src/data/demo.ts. */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { REPLICA_NAMES, replicas } from '../components/product/registry';

const title = (n: string) => n.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase());
---
<Layout title="Product replicas | BeeCastle" description="Simplified replicas of BeeCastle screens, for review." noindex>
  <Section class="pt-[clamp(120px,12vw,160px)]">
    <h1 class="m-0 text-h1 font-extrabold">Product replicas</h1>
    <p class="m-0 mt-4 max-w-[64ch] text-lede text-ink-3">
      Simplified copies of real BeeCastle screens, built in HTML. Every company, person and number is invented.
      Use one on a product, solution or integration page with <code>replica: name</code> on a section.
    </p>
    <div class="mt-12 grid gap-16">
      {REPLICA_NAMES.map((name) => {
        const C = replicas[name];
        return (
          <div>
            <h2 class="m-0 text-h3 font-bold">{title(name)}</h2>
            <p class="m-0 mb-5 mt-1 font-mono text-[13px] text-ink-3">replica: {name}</p>
            <div class={name === 'revenue-chart' ? 'max-w-[520px]' : ''}><C /></div>
          </div>
        );
      })}
    </div>
  </Section>
</Layout>
