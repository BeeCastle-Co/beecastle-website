---
/* Thank-you pages for the gated downloads, at /<slug>/thanks-<token>/ (see
   src/data/downloads.ts). Netlify shows one after the page's form is sent;
   it is the only place the PDF is linked. Kept out of search and the sitemap. */
import Layout from '../../layouts/Layout.astro';
import ThanksPanel from '../../components/ThanksPanel.astro';
import { downloads, type Download } from '../../data/downloads';

export function getStaticPaths() {
  return Object.values(downloads).map((download) => ({ params: { download: download.slug, thanks: `thanks-${download.thanksToken}` }, props: { download } }));
}
const { download } = Astro.props as { download: Download };
---
<Layout title="Thanks | BeeCastle" description={`Thanks for your interest. Download ${download.label} from BeeCastle.`} noindex>
  <ThanksPanel heading={download.thanksHeading} message="Your download is ready. The link opens the PDF in a new tab." backHref={download.pdfUrl} backLabel="Download the PDF" />
</Layout>
