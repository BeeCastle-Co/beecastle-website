---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CategoryPill from '../../components/CategoryPill.astro';
import PostCard from '../../components/PostCard.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import { getPosts } from '../../lib/blog';
import { t } from '../../i18n';
import { formatDate } from '../../lib/inline';

/* One page per Markdown file in src/content/blog/, at /blog/<file-name>/. */
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 230));

/* Three more to read: same category first, then the newest. */
const all = (await getPosts()).filter((p) => p.id !== post.id);
const related = [
  ...all.filter((p) => p.data.categories.some((c) => d.categories.includes(c))),
  ...all,
].filter((p, i, arr) => arr.findIndex((q) => q.id === p.id) === i).slice(0, 3);

const here = new URL(`/blog/${post.id}/`, Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.summary,
    datePublished: d.date.toISOString(),
    mainEntityOfPage: here,
    ...(d.image ? { image: new URL(d.image.src, Astro.site).href } : {}),
    publisher: { '@id': new URL('/#organization', Astro.site).href },
    author: { '@id': new URL('/#organization', Astro.site).href },
  },
];
const toc = headings.filter((h) => h.depth === 2);
---
<Layout title={`${d.title} | BeeCastle`} description={d.summary} image={d.image?.src} type="article" publishedTime={d.date} schema={schema}>
  <article>
    <header class="px-gut pb-10 pt-[clamp(120px,12vw,160px)]">
      <div class="mx-auto max-w-[860px]">
        <a href="/blog/" class="rv inline-flex items-center gap-1.5 text-[14px] font-semibold text-cyan-deep no-underline hover:text-ink" data-i18n="cta.allPosts">
          <Icon name="arrow" class="size-4 rotate-180" /> {t('cta.allPosts')}
        </a>
        <div class="rv mt-6 flex flex-wrap items-center gap-2">
          {d.categories.map((c) => <CategoryPill slug={c} />)}
        </div>
        <h1 class="rv m-0 mt-4 text-h1 font-extrabold leading-[1.08]">{d.title}</h1>
        <p class="rv m-0 mt-5 text-lede text-ink-3">{d.summary}</p>
        <p class="rv m-0 mt-5 font-mono text-[13px] text-ink-3">
          <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          <span aria-hidden="true"> · </span><T k="blog.minRead" vars={{ minutes }} />
        </p>
      </div>
    </header>

    {d.image && (
      <div class="px-gut">
        <Image src={d.image} alt={d.imageAlt ?? ''} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1100px) 100vw, 1100px"
               loading="eager" fetchpriority="high" class="rv mx-auto aspect-[21/9] h-auto w-full max-w-[1100px] rounded-xl object-cover shadow-2" />
      </div>
    )}

    <div class="px-gut py-[clamp(48px,6vw,80px)]">
      <div class="mx-auto grid max-w-[1100px] gap-12 lg:grid-cols-[1fr_240px]">
        <div class="prose min-w-0 max-w-prose">
          <Content />
        </div>
        {toc.length > 2 && (
          <aside class="max-lg:hidden">
            <nav aria-label={t('blog.inThisPost')} data-i18n-attr="aria-label:blog.inThisPost" class="sticky top-28">
              <T as="p" k="blog.inThisPost" class="m-0 mb-3 font-mono text-[12px] uppercase tracking-[.14em] text-ink-3" />
              <ul class="m-0 grid list-none gap-2 border-l border-rule p-0 pl-4 text-[14px]">
                {toc.map((h) => <li><a href={`#${h.slug}`} class="text-ink-2 no-underline hover:text-cyan-deep">{h.text}</a></li>)}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </div>
  </article>

  <CTABand />

  <section class="px-gut py-sec">
    <div class="mx-auto max-w-wrap">
      <T as="h2" k="blog.keepReading" class="m-0 mb-8 text-h2 font-bold" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>
</Layout>
