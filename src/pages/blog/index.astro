---
import Layout from '../../layouts/Layout.astro';
import BlogListing from '../../components/BlogListing.astro';
import CTABand from '../../components/CTABand.astro';
import { getPosts } from '../../lib/blog';

const posts = await getPosts();
---
<Layout title="Blog | BeeCastle" description="Ideas, guides and product news for MSPs: account management, whitespace, profitability, goal setting and growing recurring revenue.">
  <BlogListing headingKey="blog.heading" ledeKey="blog.lede" posts={posts} />
  <CTABand />
</Layout>
