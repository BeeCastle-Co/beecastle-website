---
import { getCollection } from 'astro:content';
import FeaturePage from '../../layouts/FeaturePage.astro';

/* One page per Markdown file in src/content/integrations/, at /integrations/<file-name>/. */
export async function getStaticPaths() {
  const entries = await getCollection('integrations', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---
<FeaturePage entry={entry} section={{ label: 'Integrations', path: '/integrations/' }} />
