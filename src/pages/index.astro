import Ribbon from '../components/home/Ribbon.astro';
import Customers from '../components/home/Customers.astro';
import Tools from '../components/home/Tools.astro';
import Testimonials from '../components/home/Testimonials.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Integrations from '../components/home/Integrations.astro';
import Roi from '../components/home/Roi.astro';
