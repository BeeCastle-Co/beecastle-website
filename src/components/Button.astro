---
/* The one button. Every call-to-action on the site is this component, so the
   shape, size and hover behaviour change in one place.

   primary  honey. The bee colour: one per view, for the main action
   dark     navy fill
   outline  navy outline on light grounds
   light    white outline, for navy or gradient grounds

   shape: 'pill' (default) or 'app', the tighter 6px corner the product uses.

   k: a UI string key from src/i18n for the label, so it can be swapped for
   US visitors. Pass it instead of slot text wherever the label is fixed copy. */
import { t } from '../i18n';

interface Props {
  href: string;
  variant?: 'primary' | 'dark' | 'outline' | 'light';
  size?: 'md' | 'lg';
  external?: boolean;
  shape?: 'pill' | 'app';
  class?: string;
  k?: string;
}
const { k, href, variant = 'primary', size = 'md', external = /^https?:/.test(href), shape = 'pill', class: extra } = Astro.props;

const variants = {
  primary: 'bg-honey text-ink hover:bg-honey-hover shadow-[0_6px_18px_-8px_rgba(255,204,0,.8)]',
  dark: 'bg-ink text-white hover:bg-navy-2',
  outline: 'border-[1.5px] border-ink/80 text-ink hover:bg-ink hover:text-white',
  light: 'border-[1.5px] border-white/70 text-white hover:bg-white hover:text-ink',
};
const sizes = { md: 'px-5 py-2.5 text-[14.5px]', lg: 'px-7 py-3.5 text-[16px]' };
---
<a
  href={href}
  data-i18n={k}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class:list={[
    'inline-flex items-center justify-center gap-2 whitespace-nowrap font-semibold no-underline transition-all duration-200 hover:-translate-y-px',
    shape === 'app' ? 'rounded-xs' : 'rounded-full',
    shape === 'app' && variant === 'primary' ? 'shadow-none' : variants[variant],
    shape === 'app' && variant === 'primary' && 'bg-honey text-ink hover:bg-honey-hover',
    sizes[size], extra,
  ]}
>{k ? t(k) : <slot />}</a>
