---
/* Language menu: the current flag as a button; it opens a short list of the
   languages on offer, the current one ticked. Picking one saves it and
   reloads the page in it. Wired up in Localise.astro, which knows the
   visitor's current language. Works as a normal disclosure: Escape and a
   click outside close it, and focus returns to the button. */
import Flag from './Flag.astro';
import { LOCALES } from '../i18n/locales';
import { t } from '../i18n';
---
<div class="relative" data-locale-menu>
  <button type="button" data-locale-button aria-haspopup="true" aria-expanded="false" aria-controls="locale-list"
    aria-label={`${t('locale.label')}: ${LOCALES[0].name}`}
    class="flex cursor-pointer items-center gap-2 rounded-full border border-navy-line py-1.5 pl-2 pr-2.5 text-[13px] text-navy-muted transition-colors hover:border-cyan hover:text-white">
    {LOCALES.map((l, i) => (
      <span class:list={['overflow-hidden rounded-[2px] ring-1 ring-white/20', i > 0 && 'hidden']} data-flag={l.code}><Flag code={l.flag} /></span>
    ))}
    <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
  </button>
  <ul id="locale-list" hidden data-locale-list
    class="absolute bottom-[calc(100%+8px)] right-0 z-20 m-0 min-w-[220px] list-none rounded-sm border border-navy-line bg-navy-2 p-1.5 shadow-3">
    {LOCALES.map((l) => (
      <li>
        <button type="button" data-locale={l.code} lang={l.code}
          class="group flex w-full cursor-pointer items-center gap-2.5 rounded-xs px-2.5 py-2 text-left text-[13.5px] text-navy-muted transition-colors hover:bg-navy-line hover:text-white aria-[current=true]:text-white">
          <span class="overflow-hidden rounded-[2px] ring-1 ring-white/20"><Flag code={l.flag} /></span>
          <span class="flex-1">{l.name}</span>
          <svg viewBox="0 0 24 24" class="size-4 text-honey opacity-0 group-aria-[current=true]:opacity-100" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </button>
      </li>
    ))}
  </ul>
</div>
