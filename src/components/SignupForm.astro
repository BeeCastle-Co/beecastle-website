---
/* The sign-up controls: Microsoft first, then a work email. The email form
   GETs the app's sign-up page with ?email=, as the old site did. Used on
   /sign-up/ and inside SignupPanel, so the two can never drift apart. */
import Icon from './Icon.astro';
import T from './T.astro';
import { site } from '../data/site';
import { t } from '../i18n';

interface Props {
  /** Unique per page, so the label still points at the right input. */
  id?: string;
}
const { id = 'signup-email' } = Astro.props;
---
<T as="p" k="signup.microsoftIntro" class="m-0 text-[16px] text-ink-2" />
<a href={site.microsoftSignupUrl} data-i18n="signup.microsoftButton"
   class="mt-4 flex items-center justify-center gap-3 rounded-full bg-ink px-6 py-3.5 text-[15.5px] font-semibold text-white no-underline transition-colors hover:bg-navy-2">
  <Icon name="microsoft" class="size-5" /> {t('signup.microsoftButton')}
</a>
<T as="p" k="signup.or" class="my-6 flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[.12em] text-ink-3 before:h-px before:flex-1 before:bg-rule after:h-px after:flex-1 after:bg-rule" />
<form action={site.signupUrl} method="get" class="grid gap-3">
  <label for={id} class="text-[14px] font-semibold text-ink-2" data-i18n="signup.emailLabel">{t('signup.emailLabel')} <span aria-hidden="true" class="text-ink-3">*</span></label>
  <input id={id} name="email" type="email" required autocomplete="email" placeholder={t('signup.emailPlaceholder')}
         data-i18n-attr="placeholder:signup.emailPlaceholder"
         class="rounded-full border-[1.5px] border-rule-2 bg-honey-soft/60 px-5 py-3.5 text-[16px] text-ink outline-none transition-colors placeholder:text-ink-3 focus:border-ink" />
  <T as="p" k="form.required" class="m-0 text-[13px] text-ink-3" />
  <T as="button" k="signup.submit" type="submit" class="mt-1 cursor-pointer rounded-full bg-honey px-6 py-3.5 text-[15.5px] font-semibold text-ink transition-colors hover:bg-honey-hover" />
</form>
