---
/* Mailing-list sign-up. Posts to Netlify Forms, which collects submissions in
   the Netlify dashboard with no backend of our own. The old site used a
   script-driven form; wire this to HubSpot or Mailchimp once that is decided.

   Netlify detects the form at build time by the data-netlify attribute, so
   the form must be in the static HTML, which it is. */
interface Props {
  onDark?: boolean;
  id?: string;
}
const { onDark = false, id = 'newsletter' } = Astro.props;
const field = onDark
  ? 'border-navy-line bg-navy-2 text-white placeholder:text-navy-muted focus:border-cyan'
  : 'border-rule-2 bg-card text-ink placeholder:text-ink-3 focus:border-cyan-deep';
---
<form name="newsletter" method="POST" action="/newsletter/thanks/" data-netlify="true" netlify-honeypot="company-website" class="grid gap-3" id={id}>
  <input type="hidden" name="form-name" value="newsletter" />
  <p hidden><label>Leave this empty <input name="company-website" /></label></p>
  <div class="grid gap-3 sm:grid-cols-2">
    <label class="grid gap-1.5">
      <span class:list={['text-[13px] font-semibold', onDark ? 'text-navy-muted' : 'text-ink-2']}>Name</span>
      <input name="name" type="text" required autocomplete="name" class:list={['rounded-sm border px-3.5 py-2.5 text-[15px] outline-none transition-colors', field]} />
    </label>
    <label class="grid gap-1.5">
      <span class:list={['text-[13px] font-semibold', onDark ? 'text-navy-muted' : 'text-ink-2']}>Work email</span>
      <input name="email" type="email" required autocomplete="email" class:list={['rounded-sm border px-3.5 py-2.5 text-[15px] outline-none transition-colors', field]} />
    </label>
  </div>
  <button type="submit" class:list={['mt-1 w-fit cursor-pointer rounded-full px-6 py-2.5 text-[14.5px] font-semibold transition-colors', onDark ? 'bg-cyan text-ink hover:bg-cyan-light' : 'bg-ink text-white hover:bg-navy-2']}>Subscribe</button>
</form>
