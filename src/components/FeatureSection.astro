---
/* Words on one side, a picture on the other. Pass reverse to swap sides;
   pages alternate automatically by index. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import { replicas, type ReplicaName } from './product/registry';
import { inline } from '../lib/inline';
import { accents, type Accent } from '../lib/accents';
import { site } from '../data/site';

interface Props {
  id?: string;
  heading: string;
  paragraphs?: string[];
  bullets?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  cta?: 'signup' | 'demo';
  replica?: ReplicaName;
  /** Extra props for the replica, for example the PSA name on the onboarding one. */
  replicaProps?: Record<string, unknown>;
  reverse?: boolean;
  accent?: Accent;
}
const { id, heading, paragraphs = [], bullets = [], image, imageAlt = '', cta, reverse = false, accent = 'cyan', replica, replicaProps = {} } = Astro.props;
const Replica = replica ? replicas[replica] : null;
const hasVisual = !!(image || Replica);
const a = accents[accent];
---
<section id={id} class="px-gut py-[clamp(48px,6vw,88px)]">
  <div class:list={['mx-auto grid max-w-wrap items-center gap-[clamp(32px,5vw,80px)]', hasVisual && 'lg:grid-cols-2']}>
    <div class:list={['rv', reverse && hasVisual && 'lg:order-2']}>
      <h2 class="m-0 text-h2 font-bold leading-[1.1]">{heading}</h2>
      <div class="mt-5 grid gap-3.5 text-[17px] leading-relaxed [&_a]:font-semibold [&_a]:text-cyan-deep [&_strong]:text-ink">
        {paragraphs.map((p) => <p class="m-0" set:html={inline(p)} />)}
      </div>
      {bullets.length > 0 && (
        <ul class="m-0 mt-5 grid list-none gap-2.5 p-0 text-[16.5px]">
          {bullets.map((b) => (
            <li class="flex gap-3">
              <span class:list={['mt-[3px] grid size-5 shrink-0 place-items-center rounded-full text-ink', a.soft]}>
                <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              </span>
              <span set:html={inline(b)} />
            </li>
          ))}
        </ul>
      )}
      {cta && (
        <div class="mt-7">
          {cta === 'signup'
            ? <Button href="/sign-up/">Start free trial</Button>
            : <Button href={site.demoUrl} variant="outline">Book a demo</Button>}
        </div>
      )}
    </div>
    {Replica ? (
      <div class:list={['rv relative min-w-0', reverse && 'lg:order-1']}>
        <div aria-hidden="true" class:list={['absolute inset-6 -z-10 rounded-xl blur-2xl', a.solid, 'opacity-25']}></div>
        <Replica bare {...replicaProps} />
      </div>
    ) : image && (
      <div class:list={['rv relative', reverse && 'lg:order-1']}>
        <div aria-hidden="true" class:list={['absolute inset-6 -z-10 rounded-xl blur-2xl', a.solid, 'opacity-30']}></div>
        <Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 1024px) 100vw, 600px"
               class="h-auto w-full rounded-lg bg-card shadow-3" />
      </div>
    )}
  </div>
</section>
