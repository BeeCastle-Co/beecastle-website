---
/* The row of category links above blog listings. Real links to real pages,
   so each category listing can be found and shared. */
import { CATEGORY_SLUGS, categories, type CategorySlug } from '../data/categories';
interface Props {
  current?: CategorySlug;
}
const { current } = Astro.props;
const base = 'rounded-full border px-4 py-2 text-[14px] font-semibold no-underline transition-colors';
const on = 'border-ink bg-ink text-white';
const off = 'border-rule-2 bg-card text-ink-2 hover:border-ink hover:text-ink';
---
<nav aria-label="Blog categories" class="flex flex-wrap gap-2">
  <a href="/blog/" class:list={[base, current ? off : on]} aria-current={current ? undefined : 'page'}>All posts</a>
  {CATEGORY_SLUGS.map((slug) => (
    <a href={`/categories/${slug}/`} class:list={[base, current === slug ? on : off]} aria-current={current === slug ? 'page' : undefined}>
      {categories[slug].label}
    </a>
  ))}
</nav>
