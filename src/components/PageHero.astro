---
/* The hero at the top of product, solution and integration pages: a tinted
   panel with the headline on one side and the page's picture on the other. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import { inline } from '../lib/inline';
import { accents, type Accent } from '../lib/accents';
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  headline: string;
  intro?: string[];
  bullets?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  accent?: Accent;
  /** Show the trial and demo buttons. Off for pages with their own form. */
  ctas?: boolean;
  /** "contact" swaps the free trial button for Get in touch. */
  ctaMode?: 'trial' | 'contact';
}
const { eyebrow, headline, intro = [], bullets = [], image, imageAlt = '', accent = 'cyan', ctas = true, ctaMode = 'trial' } = Astro.props;
const a = accents[accent];
---
<section class="px-gut pb-6 pt-[104px]">
  <div class:list={['relative mx-auto max-w-wrap overflow-hidden rounded-xl px-[clamp(24px,5vw,64px)] py-[clamp(40px,6vw,80px)]', a.soft]}>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-[420px] rounded-full bg-brand-gradient opacity-25 glow"></div>
    <div class="relative grid items-center gap-10 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <p class="rv m-0 mb-4 inline-flex items-center gap-2 rounded-full bg-card/80 px-3 py-1 font-mono text-[12px] font-medium uppercase tracking-[.14em] text-ink">
          <span class:list={['size-2 rounded-full', a.solid]}></span>{eyebrow}
        </p>
        <h1 class="rv m-0 text-h1 font-extrabold leading-[1.05]">{headline}</h1>
        <div class="rv mt-6 grid max-w-[60ch] gap-3 text-lede leading-relaxed text-ink-2 [&_a]:font-semibold [&_a]:text-cyan-deep [&_a]:underline [&_a]:underline-offset-[3px] [&_strong]:text-ink">
          {intro.map((p) => <p class="m-0" set:html={inline(p)} />)}
        </div>
        {bullets.length > 0 && (
          <ul class="rv m-0 mt-5 grid list-none gap-2 p-0 text-[16px] text-ink-2">
            {bullets.map((b) => (
              <li class="flex gap-2.5"><span class:list={['mt-2.5 size-1.5 shrink-0 rounded-full', a.solid]}></span><span set:html={inline(b)} /></li>
            ))}
          </ul>
        )}
        {ctas && (
          <div class="rv mt-8 flex flex-wrap gap-3">
            {ctaMode === 'contact'
              ? <Button href="/contact/" size="lg">Get in touch</Button>
              : <Button href="/sign-up/" size="lg">Start free trial</Button>}
            <Button href={site.demoUrl} variant="outline" size="lg">Book a demo</Button>
          </div>
        )}
        <slot />
      </div>
      {image && (
        <div class="rv">
          <Image src={image} alt={imageAlt} widths={[480, 800, 1100]} sizes="(max-width: 1024px) 100vw, 560px"
                 loading="eager" fetchpriority="high" class="mx-auto h-auto w-full max-w-[560px] drop-shadow-[0_24px_40px_rgba(23,39,57,.18)]" />
        </div>
      )}
    </div>
  </div>
</section>
