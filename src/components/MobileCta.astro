---
/* Phone only: the page's calls to action, placed after the first feature
   section instead of in the hero, so a reader on a phone gets to the detail
   first and meets the buttons once there is a reason to press them. */
import Button from './Button.astro';
import T from './T.astro';
import { site } from '../data/site';

interface Props {
  ctaMode?: 'trial' | 'contact';
}
const { ctaMode = 'trial' } = Astro.props;
---
<section class="px-gut pb-4 md:hidden">
  <div class="rounded-sm border border-rule bg-card p-5 shadow-1">
    <T as="p" k="mobileCta.heading" class="m-0 text-[17px] font-bold text-ink" />
    <div class="mt-3 grid grid-cols-2 gap-2">
      {ctaMode === 'contact'
        ? <Button href="/contact/" shape="app" k="cta.getInTouch" class="w-full" />
        : <Button href={site.signupUrl} shape="app" k="cta.startTrial" class="w-full" />}
      <Button href={site.demoUrl} variant="outline" shape="app" k="cta.bookDemo" class="w-full" />
    </div>
  </div>
</section>
