---
/* Replica: Customer profitability. Headline tiles, then revenue against
   margin (one dot per client, red below the target line) and where gross
   profit concentrates. */
import Frame from './Frame.astro';
import StatTile from './StatTile.astro';
import { profitability as p } from '../../data/demo';
import { money } from '../../lib/inline';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;

/* Scatter: revenue ($k) across, margin (%) up. */
const S = { w: 260, h: 150, l: 26, r: 6, t: 8, b: 16 };
const sx = (v: number) => S.l + (v / 70) * (S.w - S.l - S.r);
const sy = (m: number) => S.t + (1 - (m + 30) / 130) * (S.h - S.t - S.b);
/* Concentration bars, largest first. */
const B = { w: 260, h: 150, l: 6, b: 16, t: 8 };
const maxBar = Math.max(...p.concentration.map(([, v]) => v));
const bw = (B.w - B.l * 2) / p.concentration.length;
const by = (v: number) => B.t + (1 - Math.max(v, 0) / maxBar) * (B.h - B.t - B.b);
---
<Frame active="Customer profitability" bare={bare} class={extra}
  label="BeeCastle customer profitability: revenue, direct costs and margin, a scatter of each client's revenue against margin with the loss-makers in red, and where gross profit is concentrated">
  <p class="m-0 text-[17px] font-bold tracking-[-.01em]">Customer profitability</p>
  <div class="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-4">
    <StatTile label="Revenue" value={money(p.revenue)} sub="69 accounts" tone="info" />
    <StatTile label="Direct costs" value={money(p.directCosts)} sub="labour, licensing, products" tone="warn" />
    <StatTile label="Gross profit" value={money(p.grossProfit)} tone="ok" />
    <StatTile label="Margin" value={`${p.margin}%`} sub={`${p.withheld} accounts withheld`} tone="ok" valueTone="ok" />
  </div>
  <div class="mt-2.5 grid gap-2.5 md:grid-cols-2">
    <div class="rounded-xs border border-rule bg-card p-3">
      <p class="m-0 text-[12px] font-bold">Revenue against margin</p>
      <svg viewBox={`0 0 ${S.w} ${S.h}`} class="mt-1 w-full" aria-hidden="true">
        {[0, 35, 70, 100].map((m) => (
          <>
            <line x1={S.l} x2={S.w - S.r} y1={sy(m)} y2={sy(m)} stroke={m === p.target ? 'var(--color-ink-3)' : 'var(--color-rule)'} stroke-dasharray={m === p.target ? '4 3' : '2 3'} />
            <text x={S.l - 4} y={sy(m) + 3} text-anchor="end" font-size="7.5" fill="var(--color-ink-3)">{m}%</text>
          </>
        ))}
        <text x={S.w - S.r} y={sy(p.target) - 3} text-anchor="end" font-size="7.5" fill="var(--color-ink-3)">Target</text>
        {p.points.map(([r, m]) => <circle cx={sx(r)} cy={sy(m)} r="2.6" fill={m < p.target ? 'var(--color-bad)' : 'var(--color-ok)'} fill-opacity=".85" />)}
        <text x={S.w - S.r} y={S.h - 3} text-anchor="end" font-size="7.5" fill="var(--color-ink-3)">Revenue →</text>
      </svg>
    </div>
    <div class="rounded-xs border border-rule bg-card p-3">
      <p class="m-0 text-[12px] font-bold">Profit concentration</p>
      <svg viewBox={`0 0 ${B.w} ${B.h}`} class="mt-1 w-full" aria-hidden="true">
        <line x1={B.l} x2={B.w - B.l} y1={by(0)} y2={by(0)} stroke="var(--color-rule-2)" />
        {p.concentration.map(([, v], i) => v >= 0 ? (
          <rect x={B.l + i * bw + 2} y={by(v)} width={bw - 4} height={by(0) - by(v)} rx="2" fill="var(--color-ok)" />
        ) : (
          <rect x={B.l + i * bw + 2} y={by(0)} width={bw - 4} height={10} rx="2" fill="var(--color-bad)" />
        ))}
        <polyline fill="none" stroke="var(--color-cyan)" stroke-width="1.8"
          points={p.concentration.map((_, i) => `${B.l + i * bw + bw / 2},${B.t + (1 - [0.2, 0.37, 0.48, 0.57, 0.65, 0.72, 0.78, 0.83, 0.87, 0.86][i]) * (B.h - B.t - B.b)}`).join(' ')} />
      </svg>
      <p class="m-0 flex gap-3 text-[9.5px] text-ink-3">
        <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-ok"></span>Gross profit</span>
        <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-bad"></span>Loss</span>
        <span class="flex items-center gap-1"><span class="h-0.5 w-3 bg-cyan"></span>Cumulative share</span>
      </p>
    </div>
  </div>
</Frame>
