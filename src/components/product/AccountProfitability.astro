---
/* Replica: one company's Profitability tab. Revenue, costs and margin, what
   the direct costs are made of, and revenue against cost month by month. */
import Frame from './Frame.astro';
import StatTile from './StatTile.astro';
import { accountProfit as a } from '../../data/demo';
import { money } from '../../lib/inline';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;

const total = a.costs.reduce((s, c) => s + c.value, 0);
const share = a.costs[0].value / total;
const R = 30, C = 2 * Math.PI * R;
const W = 300, H = 120, P = { l: 30, b: 16, t: 6 };
const max = 20000;
const bw = (W - P.l) / a.months.length;
const y = (v: number) => P.t + (1 - v / max) * (H - P.t - P.b);
---
<Frame active="Companies" bare={bare} class={extra}
  label="A BeeCastle company profitability tab: revenue, direct costs, gross profit and margin, the make-up of direct costs, and monthly revenue against costs">
  <p class="m-0 text-[15px] font-bold">Harbourline Dental <span class="text-[11px] font-normal text-ink-3">· Profitability</span></p>
  <div class="mt-2.5 grid grid-cols-2 gap-2 lg:grid-cols-4">
    <StatTile label="Revenue" value={money(a.revenue)} tone="info" />
    <StatTile label="Direct costs" value={money(a.directCosts)} tone="warn" />
    <StatTile label="Gross profit" value={money(a.grossProfit)} tone="ok" />
    <StatTile label="Margin" value={`${a.margin}%`} sub={`${money(a.effectiveRate)}/hr effective, ${a.hours} hrs`} tone="ok" valueTone="ok" />
  </div>
  <div class="mt-2.5 grid gap-2.5 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <div class="rounded-xs border border-rule bg-card p-3">
      <p class="m-0 text-[12px] font-bold">Direct cost composition</p>
      <div class="mt-2 flex items-center gap-3">
        <svg viewBox="0 0 80 80" class="size-20 shrink-0" aria-hidden="true">
          <circle cx="40" cy="40" r={R} fill="none" stroke="var(--color-rule-2)" stroke-width="12" />
          <circle cx="40" cy="40" r={R} fill="none" stroke="var(--color-cyan-deep)" stroke-width="12"
            stroke-dasharray={`${C * (1 - share)} ${C}`} transform="rotate(-90 40 40)" />
          <text x="40" y="43" text-anchor="middle" font-size="9" font-weight="700" fill="var(--color-ink)">{money(total)}</text>
        </svg>
        <div class="grid min-w-0 gap-1.5 text-[10.5px]">
          {a.costs.map((c, i) => (
            <p class="m-0 flex items-center gap-1.5"><span class:list={['size-2 shrink-0 rounded-sm', i ? 'bg-cyan-deep' : 'bg-rule-2']}></span><span class="truncate">{c.label}</span><span class="font-bold">{money(c.value)}</span></p>
          ))}
        </div>
      </div>
    </div>
    <div class="rounded-xs border border-rule bg-card p-3">
      <p class="m-0 text-[12px] font-bold">Monthly profitability</p>
      <svg viewBox={`0 0 ${W} ${H}`} class="mt-1 w-full" aria-hidden="true">
        {[0, 10000, 20000].map((t) => (
          <>
            <line x1={P.l} x2={W} y1={y(t)} y2={y(t)} stroke="var(--color-rule)" stroke-dasharray="2 3" />
            <text x={P.l - 4} y={y(t) + 3} text-anchor="end" font-size="7.5" fill="var(--color-ink-3)">${t / 1000}k</text>
          </>
        ))}
        {a.months.map((m, i) => (
          <>
            <rect x={P.l + i * bw + 6} y={y(a.revenueByMonth[i] - a.costsByMonth[i])} width={bw - 12} height={y(0) - y(a.revenueByMonth[i] - a.costsByMonth[i])} rx="2" fill="var(--color-ok)" />
            <circle cx={P.l + i * bw + bw / 2} cy={y(a.revenueByMonth[i])} r="2.5" fill="var(--color-cyan)" />
            <circle cx={P.l + i * bw + bw / 2} cy={y(a.costsByMonth[i])} r="2.5" fill="var(--color-ink-2)" />
            <text x={P.l + i * bw + bw / 2} y={H - 4} text-anchor="middle" font-size="7.5" fill="var(--color-ink-3)">{m}</text>
          </>
        ))}
      </svg>
      <p class="m-0 flex flex-wrap gap-3 text-[9.5px] text-ink-3">
        <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-ok"></span>Gross profit</span>
        <span class="flex items-center gap-1"><span class="size-2 rounded-full bg-cyan"></span>Revenue</span>
        <span class="flex items-center gap-1"><span class="size-2 rounded-full bg-ink-2"></span>Direct costs</span>
      </p>
    </div>
  </div>
</Frame>
