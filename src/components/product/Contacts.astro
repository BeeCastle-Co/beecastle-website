---
/* Replica: a company's contacts, by role, with each one's relationship score
   and when they were last in touch. */
import Frame from './Frame.astro';
import { contacts } from '../../data/demo';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
const bar = (s: number) => (s >= 70 ? 'bg-ok' : s >= 40 ? 'bg-warn' : 'bg-bad');
---
<Frame active="Companies" bare={bare} class={extra}
  label="A BeeCastle contacts list: each contact's role, relationship score and when you last spoke">
  <div class="overflow-hidden rounded-xs border border-rule bg-card">
    <div class="grid grid-cols-[minmax(0,1.6fr)_minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-3 border-b border-rule px-3 py-2 text-[9px] font-semibold uppercase tracking-[.06em] text-ink-3">
      <span>Contact</span><span>Role</span><span>Score</span><span>Last contact</span>
    </div>
    {contacts.map((c) => (
      <div class="grid grid-cols-[minmax(0,1.6fr)_minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)] items-center gap-3 border-b border-rule px-3 py-2 last:border-b-0">
        <span class="min-w-0"><span class="block truncate text-[11.5px] font-semibold">{c.name}</span><span class="block truncate text-[9.5px] text-ink-3">{c.title}</span></span>
        <span class="truncate rounded-[4px] bg-paper-2 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[.04em] text-ink-2">{c.role}</span>
        <span class="flex items-center gap-1.5"><span class="h-1.5 flex-1 overflow-hidden rounded-full bg-paper-2"><span class:list={['block h-full rounded-full', bar(c.score)]} style={`width: ${c.score}%`}></span></span><span class="text-[10.5px] font-semibold">{c.score}</span></span>
        <span class="truncate text-[10.5px] text-ink-3">{c.last}</span>
      </div>
    ))}
  </div>
</Frame>
