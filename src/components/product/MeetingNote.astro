---
/* Replica: a note on a company, linked to the meeting it came from, with the
   structured headings the team writes under. Internal to the MSP. */
import Frame from './Frame.astro';
import { meetingNote as n } from '../../data/demo';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
---
<Frame active="Companies" bare={bare} class={extra}
  label="A BeeCastle meeting note linked to the quarterly business review it came from, with what was discussed and the agreed next steps">
  <div class="rounded-xs border border-rule bg-card p-3.5">
    <div class="flex items-center justify-between">
      <p class="m-0"><span class="block text-[12.5px] font-bold">Notes</span><span class="block text-[10px] text-ink-3">Internal to your team · 3 notes</span></p>
      <span class="rounded-xs border border-rule px-2 py-1 text-[10px] font-semibold">+ New note</span>
    </div>
    <div class="mt-3 flex gap-2.5 border-t border-rule pt-3">
      <span class="grid size-7 shrink-0 place-items-center rounded-full bg-honey-soft text-[10px] font-bold">PS</span>
      <div class="min-w-0">
        <p class="m-0 text-[11.5px]"><span class="font-semibold">Priya Sandhu</span> <span class="text-ink-3">6 days ago</span></p>
        <p class="m-0 mt-1 inline-block max-w-full truncate rounded-[4px] bg-paper-2 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[.05em] text-ink-2">▣ {n.title} · {n.when} · 45 min</p>
        <p class="m-0 mt-2 text-[11.5px] font-bold">{n.title}</p>
        <p class="m-0 text-[11px] text-ink-2">{n.attendees.join(', ')} attended.</p>
        <p class="m-0 mt-2 text-[11px] font-bold">Discussed</p>
        {n.body.map((b) => <p class="m-0 ml-3 text-[11px] leading-relaxed text-ink-2">{b}</p>)}
        <p class="m-0 mt-2 text-[11px] font-bold">Next steps</p>
        {n.actions.map((a) => <p class="m-0 ml-3 text-[11px] leading-relaxed text-ink-2">{a}</p>)}
      </div>
    </div>
  </div>
</Frame>
