---
/* Replica: one company's overview. Header with tier, the stat tiles, next
   best actions, and the contracts and renewal runway. */
import Frame from './Frame.astro';
import StatTile from './StatTile.astro';
import Pill from './Pill.astro';
import Avatar from './Avatar.astro';
import TierBadge from './TierBadge.astro';
import { account } from '../../data/demo';
import { money } from '../../lib/inline';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
---
<Frame active="Companies" bare={bare} class={extra}
  label="A BeeCastle company page: billed MRR, recurring revenue, next renewal, next best actions and each contract's renewal runway">
  <div class="flex items-center gap-3 rounded-xs border border-rule bg-card p-3">
    <Avatar name={account.name} face={account.face} size="lg" />
    <div class="min-w-0">
      <p class="m-0 truncate text-[16px] font-bold">{account.name}</p>
      <p class="m-0 mt-0.5 flex flex-wrap items-center gap-2 text-[10.5px] text-ink-3">
        <TierBadge tier={account.tier} /> {money(account.revenue90d)} agreement revenue, last 90 days <Pill tone="ok" label="Active" />
      </p>
    </div>
  </div>
  <div class="mt-2.5 grid grid-cols-2 gap-2 lg:grid-cols-4">
    <StatTile label="Billed MRR" value={money(account.mrr)} sub="latest invoiced month" tone="ok" />
    <StatTile label="Recurring (90d)" value={money(account.recurring90d)} sub="last 3 months" tone="info" />
    <StatTile label="Next renewal" value={account.nextRenewal} sub="Managed IT Services" tone="honey" />
    <StatTile label="Open P1 tickets" value={String(account.openP1)} sub="0% vs previous period" tone="ok" />
  </div>
  <div class="mt-2.5 grid gap-2.5 lg:grid-cols-2">
    <div class="rounded-xs border border-rule bg-card p-3">
      <p class="m-0 text-[12.5px] font-bold">Next best actions</p>
      <p class="m-0 text-[10px] text-ink-3">Highest-value live signals for this account</p>
      {account.actions.map((a) => (
        <div class="mt-2 flex items-start justify-between gap-3 border-t border-rule pt-2">
          <span class="min-w-0">
            <Pill tone={a.tone as 'bad' | 'warn' | 'info'} label={a.kind} />
            <span class="mt-1 block text-[11.5px] font-semibold">{a.label}</span>
            {a.note && <span class="block text-[10px] text-ink-3">{a.note}</span>}
          </span>
          <span class="text-[11.5px] font-bold">{money(a.value)}</span>
        </div>
      ))}
    </div>
    <div class="rounded-xs border border-rule bg-card p-3">
      <p class="m-0 text-[12.5px] font-bold">Contracts and renewal runway</p>
      {account.contracts.map((c) => (
        <div class="mt-2.5">
          <div class="flex items-baseline justify-between gap-2">
            <span class="truncate text-[11.5px] font-semibold">{c.name}</span>
            <span class="font-mono text-[10.5px] font-semibold">{money(c.perYear)}/yr</span>
          </div>
          <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-paper-2">
            <div class:list={['h-full rounded-full', c.left < 0.1 ? 'bg-warn' : 'bg-mint']} style={`width: ${Math.max(4, c.left * 100)}%`}></div>
          </div>
          <span class="text-[9.5px] text-ink-3">{c.ends}</span>
        </div>
      ))}
    </div>
  </div>
</Frame>
