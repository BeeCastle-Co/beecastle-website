---
/* Replica: the sales dashboard. Pipeline tiles, opportunity value by stage
   over the coming months, and the top opportunities closing soon. */
import Frame from './Frame.astro';
import StatTile from './StatTile.astro';
import Pill from './Pill.astro';
import { sales as s } from '../../data/demo';
import { money } from '../../lib/inline';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
const W = 300, H = 110, P = { l: 26, b: 14, t: 6 };
const max = 80;
const bw = (W - P.l) / s.months.length;
const y = (v: number) => P.t + (1 - v / max) * (H - P.t - P.b);
---
<Frame active="Sales dashboard" bare={bare} class={extra}
  label="BeeCastle sales dashboard: open opportunities, outdated deals, pipeline by stage for the next six months and the top deals closing soon">
  <p class="m-0 text-[17px] font-bold tracking-[-.01em]">Sales dashboard</p>
  <div class="mt-3 grid grid-cols-3 gap-2">
    <StatTile label="Open opportunities" value={String(s.open)} sub={`${money(s.pipeline)} pipeline`} tone="info" />
    <StatTile label="Outdated" value={String(s.outdated)} sub="past expected close" tone="bad" />
    <StatTile label="No recent activity" value={String(s.noActivity)} sub="30 days" tone="warn" />
  </div>
  <div class="mt-2.5 grid gap-2.5 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <div class="rounded-xs border border-rule bg-card p-3">
      <p class="m-0 text-[12px] font-bold">Opportunity value by stage</p>
      <svg viewBox={`0 0 ${W} ${H}`} class="mt-1 w-full" aria-hidden="true">
        {[0, 40, 80].map((t) => (
          <>
            <line x1={P.l} x2={W} y1={y(t)} y2={y(t)} stroke="var(--color-rule)" stroke-dasharray="2 3" />
            <text x={P.l - 4} y={y(t) + 3} text-anchor="end" font-size="7.5" fill="var(--color-ink-3)">${t}k</text>
          </>
        ))}
        {s.stages.map(([a, b], i) => (
          <>
            <rect x={P.l + i * bw + 7} y={y(a)} width={bw - 14} height={y(0) - y(a)} fill="var(--color-periwinkle)" />
            <rect x={P.l + i * bw + 7} y={y(a + b)} width={bw - 14} height={y(a) - y(a + b)} rx="1.5" fill="var(--color-mint)" />
            <text x={P.l + i * bw + bw / 2} y={H - 3} text-anchor="middle" font-size="7.5" fill="var(--color-ink-3)">{s.months[i]}</text>
          </>
        ))}
      </svg>
      <p class="m-0 flex gap-3 text-[9.5px] text-ink-3">
        <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-periwinkle"></span>Proposal sent</span>
        <span class="flex items-center gap-1"><span class="size-2 rounded-sm bg-mint"></span>Negotiation</span>
      </p>
    </div>
    <div class="overflow-hidden rounded-xs border border-rule bg-card">
      <p class="m-0 border-b border-rule px-3 py-2 text-[12px] font-bold">Top opportunities</p>
      {s.top.map((o) => (
        <div class="flex items-center gap-3 border-b border-rule px-3 py-2 last:border-b-0">
          <span class="min-w-0 flex-1">
            <span class="block truncate text-[11.5px] font-semibold">{o.company}</span>
            <span class="block truncate text-[10px] text-ink-3">{o.deal} · {o.owner}</span>
          </span>
          <span class="shrink-0 text-right">
            <span class="block text-[11.5px] font-bold">{money(o.value)}</span>
            <span class="block text-[9.5px] text-ink-3">closes {o.close}</span>
          </span>
          <span class="max-sm:hidden"><Pill tone={o.stage === 'Negotiation' ? 'ok' : 'info'} label={o.stage} /></span>
        </div>
      ))}
    </div>
  </div>
</Frame>
