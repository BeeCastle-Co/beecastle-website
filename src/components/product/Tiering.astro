---
/* Replica: tiering settings. Clients ranked by their share of cumulative
   revenue into Platinum, Gold, Silver and Bronze, and how often each tier
   should hear from you. */
import Frame from './Frame.astro';
import TierBadge from './TierBadge.astro';
import { tiering as t } from '../../data/demo';
import { money } from '../../lib/inline';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
const fills = { platinum: 'bg-tier-platinum', gold: 'bg-tier-gold', silver: 'bg-tier-silver', bronze: 'bg-tier-bronze' };
const names = { platinum: 'Platinum', gold: 'Gold', silver: 'Silver', bronze: 'Bronze' };
---
<Frame bare={bare} class={extra}
  label="BeeCastle tiering: revenue bands for Platinum, Gold, Silver and Bronze, and the meeting cadence each tier should get">
  <p class="m-0 text-[17px] font-bold tracking-[-.01em]">Tiering</p>
  <p class="m-0 text-[10.5px] text-ink-3">Rank companies by their share of cumulative agreement revenue.</p>
  <div class="mt-3 rounded-xs border border-rule bg-card p-3">
    <div class="flex h-7 overflow-hidden rounded-xs">
      {t.bands.map((b, i) => (
        <span class:list={['grid place-items-center text-[10px] font-semibold text-ink', fills[b.tier]]} style={`width: ${b.to - (i ? t.bands[i - 1].to : 0)}%`}>{names[b.tier]}</span>
      ))}
    </div>
    <div class="relative mt-1 h-3 text-[9px] text-ink-3">
      {t.bands.slice(0, -1).map((b) => <span class="absolute -translate-x-1/2" style={`left: ${b.to}%`}>{b.to}%</span>)}
    </div>
    <p class="m-0 mt-2 text-[10.5px] text-ink-3">{money(t.revenue90d)} agreement revenue, last 90 days · {t.tiered} companies tiered</p>
  </div>
  <div class="mt-2.5 overflow-hidden rounded-xs border border-rule bg-card">
    <p class="m-0 border-b border-rule px-3 py-2 text-[12px] font-bold">Contact frequencies</p>
    {t.frequencies.map((f) => (
      <div class="grid grid-cols-3 items-center gap-3 border-b border-rule px-3 py-2 text-[11px] last:border-b-0">
        <TierBadge tier={f.tier} /><span class="rounded-xs border border-rule px-2 py-1">{f.cadence}</span><span class="text-ink-3">{f.target}</span>
      </div>
    ))}
  </div>
</Frame>
