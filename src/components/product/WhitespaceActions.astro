---
/* Replica: the Whitespace actions list. Revenue-weighted signals, each with
   the one thing to do next, on the honey button. */
import Frame from './Frame.astro';
import StatTile from './StatTile.astro';
import Pill from './Pill.astro';
import Avatar from './Avatar.astro';
import TierBadge from './TierBadge.astro';
import { companies } from '../../data/demo';
import { money } from '../../lib/inline';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
const items = [
  { c: companies[0], pill: ['bad', 'At risk'], what: 'Account at risk', detail: 'revenue -15% MoM', label: 'Revenue at risk', value: companies[0].mrr, action: 'Prepare check-in' },
  { c: companies[2], pill: ['info', 'Cross-sell'], what: 'Add Microsoft 365 backup', detail: '6 of 9 similar clients have it', label: 'Monthly value', value: 477, action: 'Create opportunity' },
  { c: companies[1], pill: ['warn', 'Renewal'], what: 'Managed support renews in 42 days', detail: 'no auto-renew on the agreement', label: 'Annual value', value: 64110, action: 'Plan renewal' },
] as const;
---
<Frame active="Whitespace" bare={bare} class={extra}
  label="BeeCastle whitespace actions: at-risk accounts, cross-sell gaps and renewals, each with its value and a next step">
  <p class="m-0 text-[17px] font-bold tracking-[-.01em]">Whitespace</p>
  <div class="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-4">
    <StatTile label="Renewals, next 90 days" value="$9,720" sub="2 agreements" tone="honey" />
    <StatTile label="Open pipeline" value="$18,400" sub="4 live deals" tone="ok" />
    <StatTile label="Accounts at risk" value="13" sub="health or revenue decline" tone="bad" />
    <StatTile label="Cross-sell potential" value="70" sub="stack gaps" tone="info" />
  </div>
  <div class="mt-3 grid gap-2">
    {items.map((i) => (
      <div class="flex items-center gap-3 rounded-xs border border-rule bg-card p-3">
        <Avatar name={i.c.name} face={i.c.face} size="md" />
        <span class="min-w-0 flex-1">
          <span class="flex items-center gap-2"><span class="truncate text-[12px] font-bold">{i.c.name}</span><TierBadge tier={i.c.tier} /></span>
          <span class="mt-0.5 flex items-center gap-1.5"><Pill tone={i.pill[0]} label={i.pill[1]} /><span class="truncate text-[11px] font-semibold">{i.what}</span></span>
          <span class="block truncate text-[10px] text-ink-3">{i.detail}</span>
        </span>
        <span class="shrink-0 text-right">
          <span class="block text-[8.5px] font-semibold uppercase tracking-[.06em] text-ink-3">{i.label}</span>
          <span class="block text-[14px] font-bold">{money(i.value)}</span>
          <span class="mt-1 inline-block rounded-xs bg-honey px-2 py-1 text-[10px] font-semibold text-ink max-sm:hidden">{i.action} →</span>
        </span>
      </div>
    ))}
  </div>
</Frame>
