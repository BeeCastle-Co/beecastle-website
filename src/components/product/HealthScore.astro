---
/* Replica: the health score settings. Segmented controls and weight sliders,
   and the good / watch / at risk bands along the bottom. */
import Frame from './Frame.astro';
import Pill from './Pill.astro';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
const weights = [['Decision makers', 50], ['Senior influencers', 20], ['Team members', 20], ['Other contacts', 10]] as const;
const Seg = (opts: string[], on: string) => opts.map((o) => ({ o, on: o === on }));
---
<Frame bare={bare} class={extra}
  label="BeeCastle health score settings: how often you should be in touch, what counts most, and whose relationship matters most">
  <p class="m-0 text-[17px] font-bold tracking-[-.01em]">Health score</p>
  <p class="m-0 mt-0.5 max-w-[60ch] text-[10.5px] text-ink-3">One number per company, 0 to 100. Relationship strength, the tone of recent conversations, then service pulls it down.</p>
  <div class="mt-3 rounded-xs border border-rule bg-card p-3">
    <p class="m-0 text-[12px] font-bold">1. Relationship</p>
    <div class="mt-2.5 grid gap-3 sm:grid-cols-2">
      {[['How often should we be in touch?', Seg(['Monthly', 'Quarterly', 'Half-yearly'], 'Quarterly')], ['What counts most?', Seg(['Email', 'Calls', 'Meetings'], 'Meetings')]].map(([q, opts]) => (
        <div>
          <p class="m-0 text-[10.5px] font-semibold">{q as string}</p>
          <div class="mt-1 grid grid-cols-3 rounded-xs bg-paper-2 p-0.5">
            {(opts as { o: string; on: boolean }[]).map(({ o, on }) => <span class:list={['rounded-[4px] py-1 text-center text-[10.5px]', on ? 'bg-card font-semibold text-ink shadow-1' : 'text-ink-3']}>{o}</span>)}
          </div>
        </div>
      ))}
    </div>
    <p class="m-0 mt-3 text-[10.5px] font-semibold">Whose relationship matters most?</p>
    <div class="mt-1.5 grid gap-x-5 gap-y-2 sm:grid-cols-2">
      {weights.map(([who, w]) => (
        <div>
          <p class="m-0 flex justify-between text-[10.5px]"><span>{who}</span><span class="font-semibold">{w}%</span></p>
          <div class="relative mt-1 h-1 rounded-full bg-paper-2">
            <div class="h-full rounded-full bg-honey" style={`width: ${w}%`}></div>
            <span class="absolute top-1/2 size-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-card bg-honey shadow-1" style={`left: ${w}%`}></span>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="mt-2.5 flex flex-wrap items-center gap-4 rounded-xs border border-rule bg-card px-3 py-2">
    {[['ok', 'Good', '41'], ['warn', 'Watch', '23'], ['bad', 'At risk', '9']].map(([t, l, n]) => (
      <span class="flex items-center gap-2"><Pill tone={t as 'ok' | 'warn' | 'bad'} label={l} /><span class="text-[14px] font-bold">{n}</span></span>
    ))}
  </div>
</Frame>
