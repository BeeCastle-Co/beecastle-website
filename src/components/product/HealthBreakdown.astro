---
/* Replica: the health score explained. The score, the chain that produced it
   (relationship, tone, warning cap, service drag), the rule that applied and
   the relationship weights by role. Every number traces back to a reason. */
import Frame from './Frame.astro';
import Pill from './Pill.astro';

interface Props {
  bare?: boolean;
  class?: string;
}
const { bare = false, class: extra } = Astro.props;
const chain = [['90', 'Relationship'], ['+2', 'Tone'], ['≤40', 'Warning cap'], ['none', 'Service drag']];
const roles = [['Decision makers', '1 contact', '100', '56%', '55.6'], ['Senior influencers', '1 contact', '100', '22%', '22.2'], ['Team members', '2 contacts', '58', '22%', '12.9']];
---
<Frame active="Portfolio health" bare={bare} class={extra}
  label="BeeCastle health score breakdown: a score of 40 at risk, built from relationship 90, tone plus 2 and a warning cap of 40 after a customer email mentioned going to tender">
  <div class="rounded-xs border border-rule bg-card p-3.5">
    <div class="flex items-start justify-between">
      <p class="m-0"><span class="block text-[10.5px] text-ink-3">Health</span><span class="text-[30px] font-bold leading-none text-bad">40<span class="text-[15px]">%</span></span></p>
      <Pill tone="bad" label="At risk" />
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-center">
      {chain.map(([v, l], i) => (
        <>
          {i > 0 && <span class="text-[10px] text-ink-3" aria-hidden="true">→</span>}
          <span><span class:list={['block text-[13px] font-semibold', v === 'none' ? 'text-ink-3' : 'text-ink']}>{v}</span><span class="block text-[9.5px] text-ink-3">{l}</span></span>
        </>
      ))}
      <span class="text-[15px] font-bold">= 40</span>
    </div>
    <p class="m-0 mt-3 flex items-center gap-2 text-[10px] text-ink-3 after:h-px after:flex-1 after:bg-rule">Warning cap</p>
    <p class="m-0 mt-1.5 text-[11px] leading-relaxed text-ink-2">A ceiling of 40 applies when an incoming email in the last 90 days carries a churn warning. It is a configured rule, not a calculated probability.</p>
    <p class="m-0 mt-1.5 text-[11px] font-semibold">Relationship 90 + tone 2 = 92. The lower of 92 and the cap 40: <span class="text-bad">40</span>.</p>
    <p class="m-0 mt-1.5 text-[10.5px] font-semibold text-cyan-deep underline">12 Sept 2026 · Re: Contract options for next year</p>
    <p class="m-0 mt-3 flex items-center gap-2 text-[10px] text-ink-3 after:h-px after:flex-1 after:bg-rule">Relationship</p>
    {roles.map(([r, n, s, w, t]) => (
      <p class="m-0 mt-1.5 grid grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(0,.7fr))] items-baseline gap-2 text-[10.5px]">
        <span class="truncate">{r}</span><span class="text-ink-3">{n}</span><span class="text-right">{s}</span><span class="text-right text-ink-3">×{w}</span><span class="text-right font-bold">{t}</span>
      </p>
    ))}
    <p class="m-0 mt-3 flex items-center gap-2 text-[10px] text-ink-3 after:h-px after:flex-1 after:bg-rule">Service</p>
    <p class="m-0 mt-1.5 text-[10.5px] text-ink-3">No tickets in the last 90 days, so service does not weigh in.</p>
  </div>
</Frame>
