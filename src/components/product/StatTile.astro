---
/* One of the app's stat cards: small uppercase label, big number, a line of
   context and a tinted icon chip. */
interface Props {
  label: string;
  value: string;
  sub?: string;
  tone?: 'bad' | 'warn' | 'ok' | 'info' | 'honey';
  /** Value colour, for a figure that carries meaning (a red drop). */
  valueTone?: 'bad' | 'ok';
}
const { label, value, sub, tone = 'info', valueTone } = Astro.props;
const chips = {
  bad: 'bg-bad-soft text-bad-deep', warn: 'bg-warn-soft text-warn-deep', ok: 'bg-ok-soft text-ok-deep',
  info: 'bg-periwinkle-soft text-cyan-deep', honey: 'bg-honey-soft text-honey-deep',
};
---
<div class="relative min-w-0 rounded-xs border border-rule bg-card p-3">
  <span class:list={['absolute right-2.5 top-2.5 grid size-5 place-items-center rounded-[4px] text-[11px] font-bold', chips[tone]]}>{tone === 'bad' ? '!' : tone === 'ok' ? '✓' : '$'}</span>
  <p class="m-0 truncate pr-6 text-[9.5px] font-semibold uppercase tracking-[.06em] text-ink-3">{label}</p>
  <p class:list={['m-0 mt-1 text-[19px] font-bold leading-tight tracking-[-.01em]', valueTone === 'bad' ? 'text-bad' : valueTone === 'ok' ? 'text-ok' : 'text-ink']}>{value}</p>
  {sub && <p class="m-0 mt-0.5 truncate text-[10.5px] text-ink-3">{sub}</p>}
</div>
