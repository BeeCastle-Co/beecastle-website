---
/* Replica: Portfolio health. The stat tiles and the customer portfolio table
   with health, reason, MRR, revenue change and gross margin per company. */
import Frame from './Frame.astro';
import StatTile from './StatTile.astro';
import Pill from './Pill.astro';
import Avatar from './Avatar.astro';
import TierBadge from './TierBadge.astro';
import { companies, portfolio } from '../../data/demo';
import { money } from '../../lib/inline';

interface Props {
  rows?: number;
  bare?: boolean;
  class?: string;
}
const { rows = 5, bare = false, class: extra } = Astro.props;
const healthPill = { critical: ['bad', 'Critical'], watch: ['warn', 'Watch'], ok: ['ok', 'No flags'] } as const;
---
<Frame active="Portfolio health" bare={bare} class={extra}
  label="BeeCastle portfolio health: MRR needing attention, companies at risk, and a table of each client's health, revenue change and gross margin">
  <p class="m-0 text-[9.5px] font-semibold uppercase tracking-[.1em] text-cyan-deep">Customer success</p>
  <p class="m-0 mt-0.5 text-[17px] font-bold tracking-[-.01em]">Portfolio health</p>
  <div class="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-4">
    <StatTile label="MRR needing attention" value={money(portfolio.mrrAtRisk)} sub={`Across ${portfolio.mrrAtRiskAcross} companies`} tone="bad" />
    <StatTile label="Needs attention" value={String(portfolio.needsAttention)} sub={`${portfolio.critical} critical`} tone="bad" />
    <StatTile label="Margin review" value={String(portfolio.marginReview)} sub={`${portfolio.indeterminate} indeterminate`} tone="warn" />
    <StatTile label="Renewals in 60 days" value={String(portfolio.renewals60)} sub="3 platinum" tone="info" />
  </div>
  <div class="mt-3 overflow-hidden rounded-xs border border-rule bg-card">
    <div class="grid grid-cols-[minmax(0,1.5fr)_minmax(0,1.4fr)_70px_60px] gap-3 border-b border-rule px-3 py-2 text-[9px] font-semibold uppercase tracking-[.06em] text-ink-3 sm:grid-cols-[minmax(0,1.5fr)_minmax(0,1.4fr)_70px_60px_64px]">
      <span>Company</span><span>Health and reason</span><span>MRR</span><span>Change</span><span class="max-sm:hidden">Margin</span>
    </div>
    {companies.slice(0, rows).map((c) => (
      <div class="grid grid-cols-[minmax(0,1.5fr)_minmax(0,1.4fr)_70px_60px] items-center gap-3 border-b border-rule px-3 py-2.5 last:border-b-0 sm:grid-cols-[minmax(0,1.5fr)_minmax(0,1.4fr)_70px_60px_64px]">
        <span class="flex min-w-0 items-center gap-2">
          <Avatar name={c.name} face={c.face} />
          <span class="min-w-0">
            <span class="block truncate text-[12px] font-semibold">{c.name}</span>
            <TierBadge tier={c.tier} />
          </span>
        </span>
        <span class="min-w-0">
          <Pill tone={healthPill[c.health][0]} label={healthPill[c.health][1]} />
          <span class="mt-0.5 block truncate text-[10.5px] text-ink-3">{c.reason}</span>
        </span>
        <span class="text-[12px] font-semibold">{money(c.mrr)}</span>
        <span class:list={['text-[11.5px] font-semibold', c.change < 0 ? 'text-bad' : c.change > 0 ? 'text-ok' : 'text-ink-3']}>
          {c.change < 0 ? '↓' : c.change > 0 ? '↑' : ''}{Math.abs(c.change).toFixed(1)}%
        </span>
        <span class:list={['text-[11.5px] font-semibold max-sm:hidden', c.margin === null ? 'text-ink-3' : c.margin < 15 ? 'text-bad' : c.margin < 35 ? 'text-warn' : 'text-ok']}>
          {c.margin === null ? 'Unknown' : `${c.margin.toFixed(1)}%`}
        </span>
      </div>
    ))}
  </div>
</Frame>
