---
/* Small UI icons, drawn inline so they take currentColor. Add a path here
   rather than pulling in an icon library for a handful of glyphs. */
interface Props {
  name: 'arrow' | 'chevron' | 'check' | 'mail' | 'microsoft' | 'linkedin' | 'youtube' | 'x' | 'facebook' | 'menu' | 'close' | 'play';
  class?: string;
}
const { name, class: extra = 'size-4' } = Astro.props;
const stroke: Record<string, string> = {
  arrow: 'M5 12h14M13 6l6 6-6 6',
  chevron: 'M6 9l6 6 6-6',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  mail: 'M3 6.5h18v11H3zM3.5 7l8.5 6.5L20.5 7',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
};
const fill: Record<string, string> = {
  linkedin: 'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.1 1.43-2.1 2.9V21H9z',
  youtube: 'M23 7.2a3 3 0 00-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 001 7.2 31 31 0 00.6 12 31 31 0 001 16.8a3 3 0 002.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 002.1-2.1 31 31 0 00.4-4.8 31 31 0 00-.4-4.8zM9.7 15.1V8.9l5.8 3.1z',
  x: 'M17.8 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z',
  facebook: 'M14 8.5V6.6c0-.9.6-1.1 1-1.1h2.6V1.6L14 1.6c-4 0-4.9 3-4.9 4.9v2H6.8v4h2.3V22.5H14V12.5h3.3l.4-4z',
  play: 'M8 5v14l11-7z',
};
---
{name === 'microsoft' ? (
  <svg viewBox="0 0 21 21" class={extra} aria-hidden="true"><path fill="#F25022" d="M1 1h9v9H1z"/><path fill="#7FBA00" d="M11 1h9v9h-9z"/><path fill="#00A4EF" d="M1 11h9v9H1z"/><path fill="#FFB900" d="M11 11h9v9h-9z"/></svg>
) : stroke[name] ? (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={extra} aria-hidden="true"><path d={stroke[name]} /></svg>
) : (
  <svg viewBox="0 0 24 24" fill="currentColor" class={extra} aria-hidden="true"><path d={fill[name]} /></svg>
)}
