---
/* Site footer. Link columns come from footerColumns in src/data/nav.ts,
   contact details from src/data/site.ts and the words from src/i18n. The
   language switcher at the bottom is wired up by Localise.astro. */
import Button from './Button.astro';
import Icon from './Icon.astro';
import Illustration from './Illustration.astro';
import NewsletterForm from './NewsletterForm.astro';
import T from './T.astro';
import { footerColumns } from '../data/nav';
import { site } from '../data/site';
import { t } from '../i18n';

const year = new Date().getFullYear();
const locales = [
  { code: 'en-AU', key: 'locale.enAU' },
  { code: 'en-US', key: 'locale.enUS' },
];
---
<footer class="relative mt-10 bg-navy px-gut pb-10 pt-20 text-navy-muted">
  <Illustration name="bee" class="absolute -top-9 right-[max(var(--spacing-gut),calc((100%-var(--container-wrap))/2))] w-20 rotate-[-8deg]" />

  <div class="mx-auto grid max-w-wrap gap-12 lg:grid-cols-[1.1fr_2fr]">
    <div>
      <img src="/logo-beecastle-full-white-text.svg" alt="BeeCastle" width="170" height="24" class="h-6 w-auto" />
      <T as="p" k="footer.blurb" class="mb-6 mt-5 max-w-[34ch] text-[15px] leading-relaxed" />
      <div class="flex flex-wrap gap-2">
        <Button href="/sign-up/" k="cta.getStarted" />
        <Button href={site.demoUrl} variant="light" k="cta.bookDemo" />
      </div>
      <ul class="m-0 mt-8 flex list-none gap-2 p-0">
        {site.social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
               class="grid size-10 place-items-center rounded-full border border-navy-line text-white transition-colors hover:border-cyan hover:text-cyan">
              <Icon name={s.icon} class="size-4" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="grid min-w-0 gap-10 sm:grid-cols-2 md:grid-cols-4">
      {footerColumns.map((col) => (
        <div>
          <T as="h2" k={col.heading} class="m-0 mb-4 font-mono text-[12px] font-medium uppercase tracking-[.14em] text-white" />
          <ul class="m-0 grid list-none gap-2.5 p-0">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-[14.5px] no-underline transition-colors hover:text-white" data-i18n={l.key} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{t(l.key)}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <T as="h2" k="footer.contactHeading" class="m-0 mb-4 font-mono text-[12px] font-medium uppercase tracking-[.14em] text-white" />
        <address class="grid gap-2.5 text-[14.5px] not-italic [overflow-wrap:anywhere]">
          <span>{site.address}</span>
          <a href={`mailto:${site.email.sales}`} class="no-underline hover:text-white">{site.email.sales}</a>
          <a href={`mailto:${site.email.help}`} class="no-underline hover:text-white">{site.email.help}</a>
          <span>{site.supportHours}</span>
        </address>
      </div>
    </div>
  </div>

  <div class="mx-auto mt-14 grid max-w-wrap gap-8 rounded-lg border border-navy-line bg-navy-2 p-7 md:grid-cols-[1fr_1.4fr] md:items-center">
    <div>
      <T as="h2" k="footer.mailingList.heading" class="m-0 text-[22px] font-bold text-white" />
      <T as="p" k="footer.mailingList.body" class="m-0 mt-2 text-[15px]" />
    </div>
    <NewsletterForm onDark id="footer-newsletter" />
  </div>

  <div class="mx-auto mt-10 flex max-w-wrap flex-wrap items-center justify-between gap-4 border-t border-navy-line pt-6 text-[13px]">
    <T as="p" k="footer.copyright" vars={{ year }} class="m-0" />
    <div role="group" aria-label={t('locale.label')} data-i18n-attr="aria-label:locale.label" class="flex flex-wrap gap-1" data-locale-switch>
      {locales.map((l) => (
        <button type="button" data-locale={l.code} data-i18n={l.key} aria-pressed={l.code === 'en-AU' ? 'true' : 'false'}
                class="cursor-pointer rounded-full border border-navy-line px-3 py-1.5 text-[13px] text-navy-muted transition-colors hover:border-cyan hover:text-white aria-pressed:border-cyan aria-pressed:text-white">{t(l.key)}</button>
      ))}
    </div>
  </div>
</footer>
