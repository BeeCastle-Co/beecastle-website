---
/* One customer quote from the testimonials collection. 'feature' is the
   large lead quote; the default is the smaller hairline card. */
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
  feature?: boolean;
}
const { testimonial, feature = false } = Astro.props;
const d = testimonial.data;
const { Content } = await render(testimonial);
const quoteMarks = "[&>p:first-child]:before:content-['\\201C'] [&>p:last-child]:after:content-['\\201D']";
---
<figure class:list={['rv m-0 flex flex-col', feature ? 'h-full' : 'rounded-sm border border-rule bg-card p-7']}>
  {feature && <p class="m-0 mb-8 text-[12px] font-semibold uppercase tracking-[.12em] text-cyan-light">{d.company}</p>}
  <blockquote class:list={['m-0 flex-1 [&_p]:m-0', quoteMarks,
    feature
      ? 'text-[clamp(22px,2.3vw,32px)] font-semibold leading-[1.3] tracking-[-.02em] text-white [&_strong]:text-honey [&_strong]:font-semibold'
      : 'text-[16px] leading-relaxed text-ink-2 [&_strong]:text-ink']}>
    <Content />
  </blockquote>
  <figcaption class:list={['flex items-center gap-3.5', feature ? 'mt-10' : 'mt-6 border-t border-rule pt-5']}>
    {d.photo && (
      <Image src={d.photo} alt="" width={feature ? 64 : 48} height={feature ? 64 : 48}
             class:list={['shrink-0 rounded-full object-cover ring-1 ring-rule', feature ? 'size-16' : 'size-12']} />
    )}
    <div class="text-[14.5px] leading-snug">
      <p class:list={['m-0 font-bold', feature ? 'text-white' : 'text-ink']}>{d.name}</p>
      <p class:list={['m-0', feature ? 'text-navy-muted' : 'text-ink-3']}>{d.role}, {d.company}{d.country && ` (${d.country})`}</p>
    </div>
  </figcaption>
</figure>
