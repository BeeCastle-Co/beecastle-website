---
/* "Join BeeCastle": the shared sign-up form in a hairline card, beside the
   module composite on a dot grid. */
import { Image } from 'astro:assets';
import Band from './Band.astro';
import Eyebrow from './Eyebrow.astro';
import T from '../T.astro';
import SignupCta from '../SignupCta.astro';
import composite from '../../assets/img/bc_module_composite.webp';
---
<Band>
  <div class="grid grid-cols-1 items-stretch gap-4 lg:grid-cols-2">
    <div class="rv min-w-0 rounded-sm border border-rule bg-card p-[clamp(24px,4vw,48px)]">
      <Eyebrow index="07" k="home.signup.label" />
      <T as="h2" k="home.signup.heading" tone="honey" class="m-0 mt-4 text-h2 font-bold leading-[1.05] tracking-[-.035em]" />
      <T as="p" k="home.signup.lede" class="m-0 mt-3 text-lede text-ink-3" />
      <div class="mt-8"><SignupCta /></div>
    </div>
    <div class="rv relative grid place-items-center overflow-hidden rounded-sm bg-magenta-soft p-[clamp(24px,4vw,48px)] max-lg:order-first">
      <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(var(--color-rule-2)_1px,transparent_1px)] [background-size:20px_20px]"></div>
            <Image src={composite} alt="" widths={[480, 800, 1100]} sizes="(max-width: 1024px) 100vw, 560px"
             class="relative h-auto w-full max-w-[520px] mix-blend-multiply" />
    </div>
  </div>
</Band>
