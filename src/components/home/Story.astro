---
/* "Science, not serendipity", with the bee equation. */
import Section from '../Section.astro';
import Illustration from '../Illustration.astro';
import Button from '../Button.astro';
---
<Section>
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <div class="rv">
      <h2 class="m-0 text-h2 font-extrabold leading-[1.1]">We believe customer success is science, not serendipity</h2>
      <p class="m-0 mt-5 text-lede text-ink-3">
        Our systems, algorithms, analytics and platforms are rooted in the belief that anyone can have great relationships by following
        key rules of engagement, with a little help from BeeCastle.
      </p>
      <div class="mt-8"><Button href="/about/" variant="dark" size="lg">Read our story</Button></div>
    </div>
    <Illustration name="bee-equation" alt="Bee equals data plus relationships" class="rv w-full" />
  </div>
</Section>
