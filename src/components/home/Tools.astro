---
/* The four headline tools as a bento grid. The two wide tiles show the
   product in an app window; the two narrow tiles lead with the illustration. */
import Band from './Band.astro';
import Head from './Head.astro';
import WhitespaceGrid from '../product/WhitespaceGrid.astro';
import MeetingPlanner from '../product/MeetingPlanner.astro';
import Illustration from '../Illustration.astro';
import Icon from '../Icon.astro';
import T from '../T.astro';
import { t } from '../../i18n';

/* Name and blurb for each tool are in src/i18n under home.tools.<key>. */
const tools = [
  { key: 'whitespace', icon: 'whitespace', href: '/products/whitespace-prospecting/', tint: 'bg-cyan-soft', wide: true, replica: 'whitespace' },
  { key: 'revenue', icon: 'revenue-dashboard', href: '/products/revenue-analytics/', tint: 'bg-honey-soft' },
  { key: 'tiering', icon: 'tiering', href: '/products/account-profitability/', tint: 'bg-magenta-soft' },
  { key: 'crm', icon: 'crm-logging', href: '/products/account-insights/', tint: 'bg-mint-soft', wide: true, replica: 'meetings' },
];
---
<Band>
<Head index="01" k="home.tools" markTone="cyan" />

  <div class="mt-12 grid gap-4 lg:grid-cols-6">
    {tools.map((tool) => (
      <a href={tool.href}
         class:list={['rv group relative flex overflow-hidden rounded-sm border border-rule bg-card no-underline transition-all duration-300 hover:-translate-y-1 hover:border-rule-2 hover:shadow-2',
           tool.wide ? 'flex-col md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:col-span-4' : 'flex-col lg:col-span-2']}>
        <div class="relative z-10 flex flex-col p-[clamp(24px,2.6vw,36px)]">
          <div class:list={['grid place-items-center self-start overflow-hidden rounded-sm', tool.tint, tool.wide ? 'size-28 p-4' : 'h-44 w-full p-6']}>
            <Illustration name={tool.icon} class:list={['w-auto max-w-full object-contain transition-transform duration-500 group-hover:-rotate-3 group-hover:scale-105', tool.wide ? 'h-20!' : 'h-32!']} />
          </div>
          <T as="h3" k={`home.tools.${tool.key}.name`} class="m-0 mt-7 text-[21px] font-bold leading-tight tracking-[-.02em]" />
          <T as="p" k={`home.tools.${tool.key}.blurb`} class="m-0 mt-2.5 flex-1 text-[15px] leading-relaxed text-ink-3" />
          <span class="mt-6 inline-flex items-center gap-1.5 text-[14px] font-semibold text-cyan-deep" data-i18n="cta.learnMore">
            {t('cta.learnMore')} <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
          </span>
        </div>
        {tool.replica && (
          <div class="relative min-h-[240px] overflow-hidden rounded-sm border border-rule bg-paper max-md:mx-4 max-md:mb-4 md:my-4 md:mr-4">
            <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(var(--color-rule-2)_1px,transparent_1px)] [background-size:18px_18px]"></div>
            <div class="absolute left-6 top-8 w-[170%] transition-transform duration-500 group-hover:-translate-y-1 md:left-8 md:top-10 md:w-[190%]">
              {tool.replica === 'whitespace' ? <WhitespaceGrid bare columns={5} /> : <MeetingPlanner bare />}
            </div>
          </div>
        )}
      </a>
    ))}
  </div>
</Band>
