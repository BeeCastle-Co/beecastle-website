---
/* A product screenshot (or any slotted media) in a plain app window: a
   hairline card with a title bar, three dots and a mono address label. */
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  label?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  /** Classes for the body under the title bar. */
  bodyClass?: string;
  /** Width and height (source pixels) of the opaque part of a screenshot
      that has a drop shadow baked into its right and bottom edges. The
      window then crops the shadow away. */
  opaque?: [number, number];
}
const {
  src, alt = '', label = 'suite.beecastle.com', sizes = '(max-width: 1024px) 100vw, 760px',
  widths = [480, 800, 1200, 1600], eager = false, class: extra, bodyClass, opaque,
} = Astro.props;
const crop = src && opaque
  ? { box: `aspect-ratio: ${opaque[0]} / ${opaque[1]}`, img: `width: ${(src.width / opaque[0]) * 100}%; max-width: none` }
  : null;
---
<div class:list={['overflow-hidden rounded-sm border border-rule bg-card shadow-1', extra]}>
  <div class="flex items-center gap-3 border-b border-rule bg-paper px-4 py-2.5">
    <span aria-hidden="true" class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-rule-2"></span>
      <span class="size-2.5 rounded-full bg-rule-2"></span>
      <span class="size-2.5 rounded-full bg-rule-2"></span>
    </span>
    <span class="mx-auto truncate rounded-full border border-rule bg-card px-3 py-0.5 font-mono text-[11px] text-ink-3">{label}</span>
    <span aria-hidden="true" class="w-[46px]"></span>
  </div>
  <div class:list={['relative', bodyClass]}>
    {src ? (
      <div class="overflow-hidden" style={crop?.box}>
        <Image src={src} alt={alt} widths={widths} sizes={sizes}
               {...(eager ? { loading: 'eager', fetchpriority: 'high' } : {})}
               class="block h-auto w-full" style={crop?.img} />
      </div>
    ) : <slot />}
  </div>
</div>
