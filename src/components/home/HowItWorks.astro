---
/* Four steps from sign-up to insight, as a ruled row of cells. */
import Band from './Band.astro';
import Head from './Head.astro';
import Illustration from '../Illustration.astro';
import Button from '../Button.astro';
import Onboarding from '../product/Onboarding.astro';
import T from '../T.astro';

/* Words for each step are in src/i18n under home.howItWorks.steps.<key>. */
const steps = [
  { key: 'account', icon: 'bee', tint: 'bg-honey-soft', tilt: '-rotate-2' },
  { key: 'data', icon: 'data', tint: 'bg-cyan-soft', tilt: 'rotate-2' },
  { key: 'm365', icon: 'crm-logging', tint: 'bg-mint-soft', tilt: '-rotate-2' },
  { key: 'done', icon: 'honeycomb', tint: 'bg-magenta-soft', tilt: 'rotate-2' },
];
import { site } from '../../data/site';
---
<Band>
  <Head index="03" k="home.howItWorks" markTone="mint">
    <Button shape="app" href={site.signupUrl} size="lg" k="cta.getStartedFree" />
  </Head>

  <ol class="mt-12 grid list-none overflow-hidden rounded-sm border border-rule bg-card p-0 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="rv relative flex flex-col border-rule p-[clamp(24px,2.4vw,32px)] max-sm:[&:not(:first-child)]:border-t sm:max-lg:[&:nth-child(n+3)]:border-t sm:max-lg:[&:nth-child(even)]:border-l lg:[&:not(:first-child)]:border-l">
        <div class="flex items-center justify-between">
          <T k="home.howItWorks.step" vars={{ n: String(i + 1).padStart(2, '0') }} class="font-mono text-[12px] font-medium tracking-[.14em] text-ink-3" />
          {i === steps.length - 1 && <span aria-hidden="true" class="size-2 rounded-full bg-honey"></span>}
        </div>
        <div class:list={['mt-6 grid h-32 w-36 place-items-center rounded-sm p-4 transition-transform duration-300 hover:rotate-0', s.tint, s.tilt]}>
          <Illustration name={s.icon} class="max-h-24 w-auto" />
        </div>
        <T as="h3" k={`home.howItWorks.steps.${s.key}.title`} class="m-0 mt-6 text-[19px] font-bold tracking-[-.015em]" />
        <T as="p" k={`home.howItWorks.steps.${s.key}.body`} md class="m-0 mt-2 text-[15px] leading-relaxed text-ink-3 [&_strong]:font-semibold [&_strong]:text-ink" />
      </li>
    ))}
  </ol>
  <!-- What step 2 looks like: the self-service PSA setup and its permission check. -->
  <Onboarding class="rv mt-10" />
</Band>
