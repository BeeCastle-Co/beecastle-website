---
/* Four steps from sign-up to insight. */
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import Illustration from '../Illustration.astro';
import Button from '../Button.astro';

const steps = [
  { title: 'Create an account', body: 'Create a **free account** on BeeCastle.', icon: 'bee' },
  { title: 'Connect your data', body: 'Connect your **ConnectWise, Autotask or HaloPSA** instance as a source of contacts and information for BeeCastle to review.', icon: 'data' },
  { title: 'Connect your M365', body: 'Connect your **Microsoft 365** account (email and calendar) to automate data input.', icon: 'crm-logging' },
  { title: "That's it!", body: 'Start reviewing your business metrics, grow sales and drive profitability.', icon: 'honeycomb' },
];
const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong class="text-ink">$1</strong>');
---
<Section>
  <SectionIntro eyebrow="How it works" heading="Up and running before your coffee goes cold" align="center" />
  <div class="relative">
  <div aria-hidden="true" class="absolute left-[12%] right-[12%] top-[70px] hidden h-0.5 bg-[linear-gradient(90deg,var(--color-periwinkle),var(--color-cyan),var(--color-mint))] opacity-50 lg:block"></div>
  <ol class="relative m-0 grid list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="rv relative flex flex-col items-center text-center">
        <div class="grid size-[140px] place-items-center rounded-full border border-rule bg-card p-6 shadow-2">
          <Illustration name={s.icon} class="max-h-[80px] w-auto" />
        </div>
        <span class="-mt-4 grid size-8 place-items-center rounded-full bg-honey font-mono text-[14px] font-bold text-ink shadow-2">{i + 1}</span>
        <h3 class="m-0 mt-4 text-[20px] font-bold">{s.title}</h3>
        <p class="m-0 mt-2 max-w-[28ch] text-[15px] text-ink-3" set:html={bold(s.body)} />
      </li>
    ))}
  </ol>
  </div>
  <div class="rv mt-12 text-center"><Button href="/sign-up/" size="lg">Get started free</Button></div>
</Section>
