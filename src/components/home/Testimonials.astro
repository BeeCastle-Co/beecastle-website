---
/* Customer quotes: the first featured quote large, the next two beside it.
   Renders nothing until the collection has featured entries. */
import { getCollection } from 'astro:content';
import Band from './Band.astro';
import Head from './Head.astro';
import Quote from './Quote.astro';
import Bee from './Bee.astro';

const quotes = (await getCollection('testimonials', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const [lead, ...rest] = quotes;
---
{lead && (
  <Band tone="card">
    <Head index="02" k="home.testimonials" />

    <div class="mt-12 grid gap-4 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
      <div class="relative flex flex-col rounded-sm bg-navy p-[clamp(28px,4vw,56px)]">
        <Bee class="absolute -top-10 right-8 w-16" />
        <div class="relative flex-1"><Quote testimonial={lead} feature /></div>
      </div>
      {rest.length > 0 && (
        <div class="grid gap-4">
          {rest.map((t) => <Quote testimonial={t} />)}
        </div>
      )}
    </div>
  </Band>
)}
