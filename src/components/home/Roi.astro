---
/* ROI calculator teaser. */
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import Button from '../Button.astro';
import roi from '../../assets/img/roi-calculator.webp';
---
<Section>
  <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.3fr]">
    <div class="rv">
      <p class="m-0 mb-3 font-mono text-[12px] font-medium uppercase tracking-[.14em] text-cyan-deep">ROI calculator</p>
      <h2 class="m-0 text-h2 font-extrabold leading-[1.1]">Calculate the value BeeCastle can bring to your MSP</h2>
      <p class="m-0 mt-5 text-lede text-ink-3">See how much time your account managers can save, and how much revenue they can generate, with BeeCastle.</p>
      <div class="mt-8"><Button href="/roi-calculator/" variant="dark" size="lg">Open the calculator</Button></div>
    </div>
    <Image src={roi} alt="Example ROI table: time saved, total saved and money made per BeeCastle module" widths={[600, 900, 1200]}
           sizes="(max-width: 1024px) 100vw, 680px" class="rv h-auto w-full rounded-lg shadow-3" />
  </div>
</Section>
