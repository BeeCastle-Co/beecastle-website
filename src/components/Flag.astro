---
/* A small flag, drawn inline. Emoji flags are not used because Windows shows
   them as two letters. Official flag colours are the flags' own, not site
   tokens, the same as a partner logo keeps its colours. */
interface Props {
  code: 'au' | 'us';
  class?: string;
}
const { code, class: extra = 'h-3.5 w-5' } = Astro.props;
/* A five-point star centred on (cx, cy) with outer radius r. */
const star = (cx: number, cy: number, r: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = (Math.PI / 5) * i - Math.PI / 2;
    const rr = i % 2 ? r * 0.45 : r;
    return `${(cx + rr * Math.cos(a)).toFixed(2)},${(cy + rr * Math.sin(a)).toFixed(2)}`;
  }).join(' ');
---
{code === 'au' ? (
  <svg viewBox="0 0 20 14" class={extra} aria-hidden="true">
    <rect width="20" height="14" fill="#012169" />
    <!-- Union Jack in the canton -->
    <path d="M0 0L10 7M10 0L0 7" stroke="#fff" stroke-width="1.6" />
    <path d="M0 0L10 7M10 0L0 7" stroke="#C8102E" stroke-width=".6" />
    <path d="M5 0v7M0 3.5h10" stroke="#fff" stroke-width="2.2" />
    <path d="M5 0v7M0 3.5h10" stroke="#C8102E" stroke-width="1.2" />
    <!-- Commonwealth star and the Southern Cross -->
    <polygon points={star(5, 10.6, 1.9)} fill="#fff" />
    <polygon points={star(15, 11.6, 1.1)} fill="#fff" />
    <polygon points={star(12.6, 6.4, 1)} fill="#fff" />
    <polygon points={star(15, 2.6, 1)} fill="#fff" />
    <polygon points={star(17.4, 5.6, 1)} fill="#fff" />
    <polygon points={star(16, 7.6, .55)} fill="#fff" />
  </svg>
) : (
  <svg viewBox="0 0 20 14" class={extra} aria-hidden="true">
    <rect width="20" height="14" fill="#fff" />
    {[0, 2, 4, 6, 8, 10, 12].map((y) => <rect y={y} width="20" height="1.08" fill="#B22234" />)}
    <rect width="9" height="7.54" fill="#3C3B6E" />
    {[[1.5, 1.4], [4.5, 1.4], [7.5, 1.4], [3, 3.8], [6, 3.8], [1.5, 6.1], [4.5, 6.1], [7.5, 6.1]].map(([x, y]) => <circle cx={x} cy={y} r=".55" fill="#fff" />)}
  </svg>
)}
