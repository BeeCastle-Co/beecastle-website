---
/* A form handled by Netlify Forms: submissions land in the Netlify dashboard
   and the visitor is sent to `action`, usually a thank-you page. Netlify finds
   the form at build time by data-netlify, so it must be in the static HTML.

   Fields are data, so a new form is a list of fields rather than new markup. */
export interface FormField {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  autocomplete?: string;
  required?: boolean;
  /** Take the full row in the two-column field grid. */
  wide?: boolean;
}

interface Props {
  /** The form's name in the Netlify dashboard. */
  name: string;
  action: string;
  fields: FormField[];
  submit: string;
  /** Extra values sent with every submission, for example which page it came from. */
  hidden?: Record<string, string>;
}
const { name, action, fields, submit, hidden = {} } = Astro.props;
const input = 'w-full rounded-sm border border-rule-2 bg-card px-3.5 py-2.5 text-[15px] text-ink outline-none transition-colors placeholder:text-ink-3 focus:border-cyan-deep';
const hasRequired = fields.some((f) => f.required !== false);
---
<form name={name} method="POST" action={action} data-netlify="true" netlify-honeypot="company-website" class="grid gap-4">
  <input type="hidden" name="form-name" value={name} />
  {Object.entries(hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
  <p hidden><label>Leave this empty <input name="company-website" /></label></p>
  <div class="grid gap-4 sm:grid-cols-2">
    {fields.map((f) => (
      <label class:list={['grid gap-1.5', (f.wide || f.type === 'textarea') && 'sm:col-span-2']}>
        <span class="text-[14px] font-semibold text-ink-2">{f.label}{f.required !== false && <span aria-hidden="true" class="text-ink-3"> *</span>}</span>
        {f.type === 'textarea'
          ? <textarea name={f.name} rows="5" required={f.required !== false} class:list={[input, 'resize-y']}></textarea>
          : <input name={f.name} type={f.type ?? 'text'} required={f.required !== false} autocomplete={f.autocomplete} class={input} />}
      </label>
    ))}
  </div>
  {hasRequired && <p class="m-0 text-[13px] text-ink-3">* indicates the field is required.</p>}
  <button type="submit" class="w-fit cursor-pointer rounded-full bg-honey px-7 py-3 text-[15.5px] font-semibold text-ink transition-colors hover:bg-honey-hover">{submit}</button>
  <p class="m-0 text-[13px] text-ink-3">We handle your details as set out in our <a href="/privacy/" class="font-semibold text-cyan-deep">Privacy Policy</a>.</p>
</form>
