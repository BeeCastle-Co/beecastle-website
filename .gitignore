# Dependencies. Restored by: pnpm install
node_modules/

# Build output. Regenerated by: pnpm build
dist/

# Astro's generated cache: content types and downloaded fonts
.astro/

# Local environment. Never commit: these files hold API tokens.
.env
.env.*
!.env.example

# Internal notes: strategy, open decisions, anything not for a public repo.
# Everything under docs/private/ stays local and is never committed.
docs/private/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp

# Local Claude Code state
.claude/settings.local.json
.claude/worktrees/

# Local MCP servers (Google Analytics etc.). Paths and project IDs are per machine.
.mcp.json
